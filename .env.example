# Copy this file to .env and fill in real values. Never commit the real .env file.

# OpenAI API key used by the classification, policy, resolution, and
# document analysis agents (agents/*.py) via langchain-openai / crewai.
OPENAI_API_KEY=sk-your-openai-api-key-here

# Host/port the FastAPI app binds to (see main.py __main__ block).
APP_HOST=0.0.0.0
APP_PORT=8000
